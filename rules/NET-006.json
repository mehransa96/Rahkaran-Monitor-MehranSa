  "forEach": "dotnet",
  "when": "coalesce(dotnet.requests_per_s, 0) > 0 && coalesce(dotnet.failed_pct, 0) > params.max_pct",
  "severity": "Warning",
  "title": {
    "fa": "درخواست‌های ناموفق ASP.NET Core در {instance}",
    "en": "Failed ASP.NET Core requests in {instance}"
  },
  "explanation": {
    "fa": "{dotnet.failed_pct}٪ درخواست‌ها ناموفق‌اند ({dotnet.failed_per_s} در ثانیه از {dotnet.requests_per_s}).",
    "en": "{dotnet.failed_pct} % of requests fail ({dotnet.failed_per_s}/s of {dotnet.requests_per_s}/s)."
  },
  "recommendation": {
    "fa": "کدهای وضعیت 5xx را در صفحه IIS و رخدادهای برنامه بررسی کنید.",
    "en": "Check 5xx status codes on the IIS page and application events."
  },
  "source": {
    "kind": "General",
    "citation": "General guidance (Microsoft IIS / Windows documentation, common practice)"
  },
