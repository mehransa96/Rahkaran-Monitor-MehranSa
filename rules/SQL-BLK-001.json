{
  "id": "SQL-BLK-001",
  "layer": "Sql",
  "appliesTo": [
    "Data",
    "Report"
  ],
  "when": "sql.blocking.max_wait_s > params.warn",
  "severity": "Warning",
  "escalate": [
    {
      "when": "sql.blocking.max_wait_s > params.crit",
      "severity": "Critical"
    }
  ],
  "title": {
    "fa": "Blocking طولانی ({sql.blocking.max_wait_s} ثانیه)",
    "en": "Long blocking ({sql.blocking.max_wait_s} s)"
  },
  "explanation": {
    "fa": "سرِ زنجیرهٔ Blocking: {sql.blocking.head_summary}",
    "en": "Head blocker: {sql.blocking.head_summary}"
  },
  "recommendation": {
    "fa": "کاربر/برنامهٔ سرِ زنجیره را پیدا کنید (تراکنش باز؟). RSM هیچ Session ای را قطع نمی‌کند.",
    "en": "Find the user/program of the head blocker (open transaction?). RSM never kills a session."
  },
  "source": {
    "kind": "General",
    "citation": "General guidance (Microsoft documentation / common DBA practice)"
  },
  "verified": true,
  "confidence": 0.85,
  "params": {
    "warn": 30,
    "crit": 120
  },
  "examples": [
    {
      "facts": {
        "sql.blocking.max_wait_s": 45,
        "sql.blocking.head_summary": "session 55 …"
      },
      "expect": "Warning"
    },
    {
      "facts": {
        "sql.blocking.max_wait_s": 300,
        "sql.blocking.head_summary": "session 55 …"
      },
      "expect": "Critical"
    },
    {
      "facts": {
        "sql.blocking.max_wait_s": 0
      },
      "expect": null
    }
  ]
}
