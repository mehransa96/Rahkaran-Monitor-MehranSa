{
  "id": "PACK-001",
  "layer": "Database",
  "appliesTo": [],
  "forEach": "pack",
  "when": "coalesce(pack.breached, false)",
  "severity": "Info",
  "escalate": [
    {
      "when": "pack.breach_severity == 'Warning'",
      "severity": "Warning"
    },
    {
      "when": "pack.breach_severity == 'Critical'",
      "severity": "Critical"
    }
  ],
  "title": {
    "fa": "{pack.title_fa}: آستانه تعریف‌شده رد شد",
    "en": "{pack.title_en}: threshold exceeded"
  },
