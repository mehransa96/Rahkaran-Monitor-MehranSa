<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF shell (MVVM). Single-file, self-contained win-x64 publish; asInvoker manifest (no auto-elevation). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RSM.App</RootNamespace>
    <AssemblyName>RSM</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;fa</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <!-- Applied only by `dotnet publish` so ordinary builds (incl. Linux CI) stay framework-dependent. -->
  <PropertyGroup Label="Publish" Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RSM.Core\RSM.Core.csproj" />
    <ProjectReference Include="..\RSM.Hosting\RSM.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL-Vazirmatn.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
