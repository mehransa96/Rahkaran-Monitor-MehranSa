<UserControl x:Class="RSM.App.Views.TopologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RSM.App.Localization"
             xmlns:views="clr-namespace:RSM.App.Views">
  <!-- DataContext: TopologyPageViewModel. Discovered from ARR farms, SQL sessions and Redis CLIENT LIST; dashed links are declared in the site profile only. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" />
      <views:LiveToolbar DataContext="{Binding Live}" />
      <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding [Topo_Explain], Source={x:Static loc:Loc.Instance}}" />
      <Border Style="{StaticResource Card}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="560" FlowDirection="LeftToRight">
          <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Canvas>
                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{Binding Color}" StrokeThickness="2">
                      <Line.Style>
                        <Style TargetType="Line">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Dashed}" Value="True"><Setter Property="StrokeDashArray" Value="4 3" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Line.Style>
                    </Line>
                    <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Text="{Binding Label}" FontSize="11" Foreground="{Binding Color}" />
                  </Canvas>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Boxes}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Canvas.Left" Value="{Binding X}" />
                  <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="6" BorderThickness="1" Padding="8,4"
                          Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                          FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Roles}" Style="{StaticResource Text.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>
      </Border>
      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Topo_Edges], Source={x:Static loc:Loc.Instance}}" />
      <Border Style="{StaticResource Card}">
        <DataGrid ItemsSource="{Binding Edges}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="360">
          <DataGrid.Columns>
            <DataGridTextColumn Width="*" Binding="{Binding From}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_From]}" />
            <DataGridTextColumn Width="*" Binding="{Binding To}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_To]}" />
            <DataGridTextColumn Width="120" Binding="{Binding Kind}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Kind]}" />
            <DataGridTextColumn Width="90" Binding="{Binding Count}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Count]}" />
            <DataGridTextColumn Width="*" Binding="{Binding Label}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Detail]}" />
            <DataGridTextColumn Width="110" Binding="{Binding Source}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Source]}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
