<UserControl x:Class="RSM.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RSM.App.Localization"
             xmlns:views="clr-namespace:RSM.App.Views">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Title}" Text="{Binding [Nav_Reports], Source={x:Static loc:Loc.Instance}}" />

    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Style="{StaticResource Text.Section}" Text="{Binding [Diag_Title], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding [Diag_Explain], Source={x:Static loc:Loc.Instance}}" />
        <WrapPanel Margin="0,10,0,0">
          <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding [Diag_Site], Source={x:Static loc:Loc.Instance}}" />
          <ComboBox MinWidth="220" ItemsSource="{Binding Sites.Sites}" SelectedItem="{Binding SelectedSite}" DisplayMemberPath="Name" IsEnabled="{Binding IsIdle}" />
          <CheckBox Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="{Binding IncludeHeavy}" IsEnabled="{Binding IsIdle}"
                    Content="{Binding [Diag_Heavy], Source={x:Static loc:Loc.Instance}}" />
        </WrapPanel>
        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" FontSize="11"
                   Text="{Binding [Diag_HeavyWarning], Source={x:Static loc:Loc.Instance}}" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Style="{StaticResource Button.Primary}" Command="{Binding DiagnoseCommand}" Content="{Binding [Diag_Diagnose], Source={x:Static loc:Loc.Instance}}" />
          <Button Command="{Binding CancelCommand}" Content="{Binding [Diag_Cancel], Source={x:Static loc:Loc.Instance}}" />
          <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Text="{Binding Progress}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Style="{StaticResource Text.Section}" Text="{Binding [Diag_Export], Source={x:Static loc:Loc.Instance}}" />
        <WrapPanel>
          <RadioButton GroupName="ReportLang" Margin="0,0,12,0" IsChecked="{Binding ReportInPersian}" Content="{Binding [Diag_ReportFa], Source={x:Static loc:Loc.Instance}}" />
          <RadioButton GroupName="ReportLang" Margin="0,0,12,0" IsChecked="{Binding ReportInEnglish}" Content="{Binding [Diag_ReportEn], Source={x:Static loc:Loc.Instance}}" />
          <CheckBox Margin="12,0,0,0" IsChecked="{Binding Mask}" Content="{Binding [Diag_Mask], Source={x:Static loc:Loc.Instance}}" />
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Style="{StaticResource Button.Primary}" Command="{Binding ExportHtmlCommand}" Content="{Binding [Diag_ExportHtml], Source={x:Static loc:Loc.Instance}}" />
          <Button Command="{Binding ExportPdfCommand}" Content="{Binding [Diag_ExportPdf], Source={x:Static loc:Loc.Instance}}" />
          <Button Command="{Binding ExportBundleCommand}" Content="{Binding [Diag_ExportBundle], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
        <TextBlock Margin="0,8,0,2" Style="{StaticResource Text.Label}" Text="{Binding [Diag_ExportPath], Source={x:Static loc:Loc.Instance}}" />
        <TextBox Style="{StaticResource TextBox.Ltr}" IsReadOnly="True" Text="{Binding LastExportPath, Mode=OneWay}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Section}" Text="{Binding Summary}" TextWrapping="Wrap" />
        <views:FindingsGrid DataContext="{Binding Findings}" />
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
