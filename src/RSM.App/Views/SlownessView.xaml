<UserControl x:Class="RSM.App.Views.SlownessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RSM.App.Localization"
             xmlns:views="clr-namespace:RSM.App.Views">
  <!-- DataContext: SlownessPageViewModel. A capture only reads more often for a short time; next steps are text only. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" />
      <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding [Slow_Intro], Source={x:Static loc:Loc.Instance}}" />
      <views:LiveToolbar DataContext="{Binding Live}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <WrapPanel>
            <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding [Slow_Duration], Source={x:Static loc:Loc.Instance}}" />
            <ComboBox MinWidth="120" ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding SelectedDuration}" DisplayMemberPath="Label" />
            <Button Style="{StaticResource Button.Primary}" Margin="12,0,6,0" Command="{Binding InvestigateCommand}" Content="{Binding [Slow_Investigate], Source={x:Static loc:Loc.Instance}}" />
            <Button Margin="0,0,6,0" Command="{Binding CancelCommand}" Content="{Binding [Diag_Cancel], Source={x:Static loc:Loc.Instance}}" />
            <Button Command="{Binding ExportCommand}" Content="{Binding [Slow_Export], Source={x:Static loc:Loc.Instance}}" />
          </WrapPanel>
          <ProgressBar Height="6" Margin="0,8,0,4" Minimum="0" Maximum="100" Value="{Binding Progress}" />
          <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding Message}" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Slow_Causes], Source={x:Static loc:Loc.Instance}}" />
      <Border Style="{StaticResource Card}">
        <ListBox ItemsSource="{Binding Causes}" SelectedItem="{Binding SelectedCause}" MaxHeight="200" DisplayMemberPath="Header" />
      </Border>
      <Border Style="{StaticResource Card}" DataContext="{Binding SelectedCause}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Section}" Text="{Binding Header}" />
          <TextBlock Margin="0,2,0,6" FontSize="11" Foreground="{DynamicResource Brush.Warning}" Text="{Binding GuidanceLabel}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding Explanation}" />
          <TextBlock Style="{StaticResource Text.Label}" Margin="0,8,0,2" Text="{Binding [Slow_Evidence], Source={x:Static loc:Loc.Instance}}" />
          <DataGrid ItemsSource="{Binding Evidence}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="220">
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" Binding="{Binding Detector}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Evidence]}" />
              <DataGridTextColumn Width="110" Binding="{Binding Node}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Node]}" />
              <DataGridTextColumn Width="120" Binding="{Binding Instance}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Instance]}" />
              <DataGridTextColumn Width="80" Binding="{Binding Value}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Value]}" />
              <DataGridTextColumn Width="80" Binding="{Binding Strength}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Strength]}" />
              <DataGridTextColumn Width="150" Binding="{Binding Time}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Time]}" />
            </DataGrid.Columns>
          </DataGrid>
          <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Context}">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Text.Label}" Margin="0,8,0,2" Text="{Binding [Slow_NextSteps], Source={x:Static loc:Loc.Instance}}" />
          <ItemsControl ItemsSource="{Binding NextSteps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding [Slow_TextOnly], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Slow_Timeline], Source={x:Static loc:Loc.Instance}}" />
      <ItemsControl ItemsSource="{Binding Timeline}">
        <ItemsControl.ItemTemplate>
          <DataTemplate><views:StaticChart Data="{Binding}" ChartHeight="160" Margin="0,0,0,8" /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Slow_Past], Source={x:Static loc:Loc.Instance}}" />
      <Border Style="{StaticResource Card}">
        <DataGrid ItemsSource="{Binding Past}" SelectedItem="{Binding SelectedPast}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="220">
          <DataGrid.Columns>
            <DataGridTextColumn Width="150" Binding="{Binding Started}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Started]}" />
            <DataGridTextColumn Width="160" Binding="{Binding Site}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Site]}" />
            <DataGridTextColumn Width="*" Binding="{Binding TopCause}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_TopCause]}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
