<UserControl x:Class="RSM.App.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RSM.App.Localization"
             xmlns:views="clr-namespace:RSM.App.Views">
  <!-- DataContext: EventsPageViewModel. Timeline of every layer; selecting an event shows ±5 min on all nodes and the knowledge base. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" />
      <views:LiveToolbar DataContext="{Binding Live}" />
      <Border Style="{StaticResource Card}" Padding="10,8">
        <WrapPanel>
          <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding [Events_Layer], Source={x:Static loc:Loc.Instance}}" />
          <ComboBox MinWidth="140" Margin="0,0,12,0" ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding SelectedLayer}" DisplayMemberPath="Label" />
          <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding [Events_Severity], Source={x:Static loc:Loc.Instance}}" />
          <ComboBox MinWidth="120" Margin="0,0,12,0" ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedSeverity}" DisplayMemberPath="Label" />
          <CheckBox VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding AllNodes}" Content="{Binding [Events_AllNodes], Source={x:Static loc:Loc.Instance}}" />
          <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding [Events_Search], Source={x:Static loc:Loc.Instance}}" />
          <TextBox MinWidth="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
        </WrapPanel>
      </Border>
      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Events_Timeline], Source={x:Static loc:Loc.Instance}}" />
      <Border Style="{StaticResource Card}">
        <DataGrid ItemsSource="{Binding Timeline}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="360" SelectedItem="{Binding SelectedEvent}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="210" Binding="{Binding Time}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Time]}" />
            <DataGridTextColumn Width="120" Binding="{Binding Node}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Node]}" />
            <DataGridTextColumn Width="100" Binding="{Binding LayerText}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Layer]}" />
            <DataGridTextColumn Width="80" Binding="{Binding SeverityText}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Severity]}" />
            <DataGridTextColumn Width="200" Binding="{Binding Source}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Source]}" />
            <DataGridTextColumn Width="70" Binding="{Binding Code}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Code]}" />
            <DataGridTextColumn Width="50" Binding="{Binding Count}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Count]}" />
            <DataGridTextColumn Width="*" Binding="{Binding Message}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Message]}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Section}" Text="{Binding [Events_Kb], Source={x:Static loc:Loc.Instance}}" />
          <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding KbTitle}" />
          <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding KbExplanation}" />
          <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Accent}" Text="{Binding KbNextStep}" />
        </StackPanel>
      </Border>
      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Events_Correlated], Source={x:Static loc:Loc.Instance}}" />
      <Border Style="{StaticResource Card}">
        <DataGrid ItemsSource="{Binding Correlated}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="300">
          <DataGrid.Columns>
            <DataGridTextColumn Width="210" Binding="{Binding Time}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Time]}" />
            <DataGridTextColumn Width="120" Binding="{Binding Node}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Node]}" />
            <DataGridTextColumn Width="100" Binding="{Binding LayerText}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Layer]}" />
            <DataGridTextColumn Width="80" Binding="{Binding SeverityText}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Severity]}" />
            <DataGridTextColumn Width="200" Binding="{Binding Source}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Source]}" />
            <DataGridTextColumn Width="70" Binding="{Binding Code}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Code]}" />
            <DataGridTextColumn Width="50" Binding="{Binding Count}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Count]}" />
            <DataGridTextColumn Width="*" Binding="{Binding Message}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Message]}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Events_Groups], Source={x:Static loc:Loc.Instance}}" />
      <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding LogsNote}" />
      <Border Style="{StaticResource Card}">
        <DataGrid ItemsSource="{Binding Groups}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="360">
          <DataGrid.Columns>
            <DataGridTextColumn Width="80" Binding="{Binding Severity}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Severity]}" />
            <DataGridTextColumn Width="90" Binding="{Binding Log}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Log]}" />
            <DataGridTextColumn Width="220" Binding="{Binding Source}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Source]}" />
            <DataGridTextColumn Width="60" Binding="{Binding Id}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_EventId]}" />
            <DataGridTextColumn Width="60" Binding="{Binding Count}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Count]}" />
            <DataGridTextColumn Width="200" Binding="{Binding First}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_First]}" />
            <DataGridTextColumn Width="200" Binding="{Binding Last}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Last]}" />
            <DataGridTextColumn Width="260" Binding="{Binding Title}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_KbTitle]}" />
            <DataGridTextColumn Width="*" Binding="{Binding Message}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Message]}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
