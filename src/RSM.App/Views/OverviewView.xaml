<UserControl x:Class="RSM.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RSM.App.Localization"
             xmlns:views="clr-namespace:RSM.App.Views"
             xmlns:model="clr-namespace:RSM.Core.Model;assembly=RSM.Core">
  <!-- DataContext: OverviewViewModel. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" />
      <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding [Overview_Intro], Source={x:Static loc:Loc.Instance}}" />
      <views:LiveToolbar DataContext="{Binding Live}" />

      <ItemsControl ItemsSource="{Binding Live.Kpis}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Width="170" Margin="0,0,10,10">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Label}" />
                <TextBlock FontSize="22" FontWeight="SemiBold" FlowDirection="LeftToRight" Text="{Binding Value}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static model:Severity.Critical}">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static model:Severity.Warning}">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <UniformGrid Columns="3">
        <views:LiveChart Live="{Binding Live}" Spec="{Binding CpuChart}" Margin="0,0,8,0" />
        <views:LiveChart Live="{Binding Live}" Spec="{Binding WorkloadChart}" Margin="0,0,8,0" />
        <views:LiveChart Live="{Binding Live}" Spec="{Binding MemoryChart}" />
      </UniformGrid>

      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Live_Anomalies], Source={x:Static loc:Loc.Instance}}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding Live.AnomalyState}" />
          <ItemsControl ItemsSource="{Binding Live.Anomalies}">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Text="{Binding}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Live_Findings], Source={x:Static loc:Loc.Instance}}" />
      <Border Style="{StaticResource Card}">
        <views:FindingsGrid DataContext="{Binding Live.Findings}" MaxHeight="420" />
      </Border>
      <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding [ReadOnly_Statement], Source={x:Static loc:Loc.Instance}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
