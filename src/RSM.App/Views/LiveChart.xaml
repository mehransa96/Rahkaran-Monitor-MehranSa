<UserControl x:Class="RSM.App.Views.LiveChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
  <!-- A live time-series chart. The plot itself shows numbers only; titles and legends are WPF text (fa/en, RTL-safe). -->
  <Border Style="{StaticResource Card}" Padding="10,8">
    <DockPanel>
      <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Style="{StaticResource Text.Section}" Margin="0,0,0,4" />
      <ItemsControl x:Name="Legend" DockPanel.Dock="Bottom" Margin="0,4,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
              <Rectangle Width="12" Height="4" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,5,0" />
              <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="EmptyText" DockPanel.Dock="Bottom" Style="{StaticResource Text.Muted}" Visibility="Collapsed" />
      <scott:WpfPlot x:Name="Plot" Height="{Binding ChartHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" FlowDirection="LeftToRight" />
    </DockPanel>
  </Border>
</UserControl>
