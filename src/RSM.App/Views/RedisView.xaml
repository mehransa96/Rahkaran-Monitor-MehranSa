<UserControl x:Class="RSM.App.Views.RedisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RSM.App.Localization"
             xmlns:views="clr-namespace:RSM.App.Views">
  <!-- DataContext: RedisPageViewModel. Whitelisted read commands only; argument values of slow commands are never shown. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" />
      <views:LiveToolbar DataContext="{Binding Live}" />
      <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding Status}" />
      <UniformGrid Columns="2">
        <views:LiveChart Live="{Binding Live}" Spec="{Binding MemoryChart}" Margin="0,0,8,0" />
        <views:LiveChart Live="{Binding Live}" Spec="{Binding OpsChart}" />
      </UniformGrid>
      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Redis_Info], Source={x:Static loc:Loc.Instance}}" />
      <Border Style="{StaticResource Card}">
        <DataGrid ItemsSource="{Binding Summary}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="320">
          <DataGrid.Columns>
            <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Fact_Name]}" />
            <DataGridTextColumn Width="*" Binding="{Binding Value}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Fact_Value]}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Redis_Slowlog], Source={x:Static loc:Loc.Instance}}" />
      <Border Style="{StaticResource Card}">
        <DataGrid ItemsSource="{Binding Slowlog}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="320">
          <DataGrid.Columns>
            <DataGridTextColumn Width="150" Binding="{Binding Time}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Time]}" />
            <DataGridTextColumn Width="90" Binding="{Binding DurationMs}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_DurationMs]}" />
            <DataGridTextColumn Width="110" Binding="{Binding Command}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Command]}" />
            <DataGridTextColumn Width="*" Binding="{Binding Key}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Key]}" />
            <DataGridTextColumn Width="200" Binding="{Binding Client}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Client]}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Redis_Latency], Source={x:Static loc:Loc.Instance}}" />
      <Border Style="{StaticResource Card}">
        <DataGrid ItemsSource="{Binding Latency}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="200">
          <DataGrid.Columns>
            <DataGridTextColumn Width="*" Binding="{Binding Event}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Event]}" />
            <DataGridTextColumn Width="150" Binding="{Binding Time}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Time]}" />
            <DataGridTextColumn Width="100" Binding="{Binding LatestMs}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_LatestMs]}" />
            <DataGridTextColumn Width="100" Binding="{Binding MaxMs}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_MaxMs]}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <TextBlock Style="{StaticResource Text.Section}" Margin="0,8,0,4" Text="{Binding [Redis_Clients], Source={x:Static loc:Loc.Instance}}" />
      <Border Style="{StaticResource Card}">
        <DataGrid ItemsSource="{Binding Clients}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="260">
          <DataGrid.Columns>
            <DataGridTextColumn Width="200" Binding="{Binding Address}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Address]}" />
            <DataGridTextColumn Width="110" Binding="{Binding Connections}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Connections]}" />
            <DataGridTextColumn Width="*" Binding="{Binding Names}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_ClientNames]}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
