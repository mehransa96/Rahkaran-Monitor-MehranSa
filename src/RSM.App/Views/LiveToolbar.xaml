<UserControl x:Class="RSM.App.Views.LiveToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RSM.App.Localization">
  <!-- DataContext: LiveViewModel. Controls only read data or change RSM's own sampling; nothing acts on a server. -->
  <Border Style="{StaticResource Card}" Padding="10,8">
    <StackPanel>
      <WrapPanel>
        <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding [Live_Site], Source={x:Static loc:Loc.Instance}}" />
        <ComboBox MinWidth="180" Margin="0,0,12,0" ItemsSource="{Binding Sites.Sites}" SelectedItem="{Binding SelectedSite}" DisplayMemberPath="Name" IsEnabled="{Binding IsIdle}" />
        <Button Style="{StaticResource Button.Primary}" Margin="0,0,6,0" Command="{Binding ConnectCommand}" Content="{Binding [Live_Connect], Source={x:Static loc:Loc.Instance}}" />
        <Button Margin="0,0,16,0" Command="{Binding DisconnectCommand}" Content="{Binding [Live_Disconnect], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding [Live_Node], Source={x:Static loc:Loc.Instance}}" />
        <ComboBox MinWidth="140" Margin="0,0,16,0" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" DisplayMemberPath="Name" />
        <Button Margin="0,0,6,0" Command="{Binding PauseCommand}" Content="{Binding [Live_Pause], Source={x:Static loc:Loc.Instance}}" />
        <Button Margin="0,0,6,0" Command="{Binding ResumeCommand}" Content="{Binding [Live_Resume], Source={x:Static loc:Loc.Instance}}" />
        <Button Margin="0,0,16,0" Command="{Binding RefreshNowCommand}" Content="{Binding [Live_RefreshNow], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding [Live_WindowLabel], Source={x:Static loc:Loc.Instance}}" />
        <ComboBox MinWidth="90" Margin="0,0,12,0" ItemsSource="{Binding WindowOptions}" SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="Label" />
        <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding [Live_IntervalLabel], Source={x:Static loc:Loc.Instance}}" />
        <ComboBox MinWidth="120" ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding SelectedInterval}" DisplayMemberPath="Label" />
      </WrapPanel>
      <DockPanel Margin="0,6,0,0">
        <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0,0,12,0" Text="{Binding StateText}" />
        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding OverheadText}" />
      </DockPanel>
    </StackPanel>
  </Border>
</UserControl>
