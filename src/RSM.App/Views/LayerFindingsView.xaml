<UserControl x:Class="RSM.App.Views.LayerFindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RSM.App.Localization"
             xmlns:views="clr-namespace:RSM.App.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Title}" Text="{Binding Title}" />
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Hint}" TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}">
      <DataGrid ItemsSource="{Binding Facts}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="300" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Width="120" Binding="{Binding Node}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Finding_Node]}" />
          <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Fact_Name]}" />
          <DataGridTextColumn Width="*" Binding="{Binding Value}" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Fact_Value]}" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Border Style="{StaticResource Card}">
      <views:FindingsGrid DataContext="{Binding Findings}" />
    </Border>
  </DockPanel>
</UserControl>
