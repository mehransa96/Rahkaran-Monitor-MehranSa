<Project Sdk="Microsoft.NET.Sdk">
  <!-- Composition root shared by RSM.App and (P5) RSM.Cli. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RSM.Hosting</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RSM.Core\RSM.Core.csproj" />
    <ProjectReference Include="..\RSM.Safety\RSM.Safety.csproj" />
    <ProjectReference Include="..\RSM.Storage\RSM.Storage.csproj" />
    <ProjectReference Include="..\RSM.Collectors.Sql\RSM.Collectors.Sql.csproj" />
    <ProjectReference Include="..\RSM.Collectors.Redis\RSM.Collectors.Redis.csproj" />
    <ProjectReference Include="..\RSM.Collectors.Rahkaran\RSM.Collectors.Rahkaran.csproj" />
    <ProjectReference Include="..\RSM.Collectors.Database\RSM.Collectors.Database.csproj" />
    <ProjectReference Include="..\RSM.Collectors.Windows\RSM.Collectors.Windows.csproj" />
    <ProjectReference Include="..\RSM.Collectors.Iis\RSM.Collectors.Iis.csproj" />
    <ProjectReference Include="..\RSM.Reporting\RSM.Reporting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <!-- Default rules ship inside the exe; a rules/ folder next to RSM.exe overrides them by id. -->
    <EmbeddedResource Include="..\..\rules\*.json" LogicalName="rules/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RSM.Tests" />
  </ItemGroup>
</Project>
