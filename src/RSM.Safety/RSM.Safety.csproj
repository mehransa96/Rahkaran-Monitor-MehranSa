<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The single safety boundary. Only this assembly may own SQL connections/commands, sockets, HTTP and
    data-folder file writes (it is exempt from BannedSymbols.NonSafety.txt, but not from BannedSymbols.txt).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RSM.Safety</RootNamespace>
    <RsmSafetyBoundary>true</RsmSafetyBoundary>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RSM.Core\RSM.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RSM.Safety.Tests" />
  </ItemGroup>
</Project>
