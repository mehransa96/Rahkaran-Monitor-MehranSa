<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    CI-only ASP.NET Core app played by the "customer" IIS (P4 acceptance: GC/thread-pool counters for an ASP.NET Core
    app under IIS, in-process and out-of-process). Not part of RSM.sln and never shipped.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>
</Project>
