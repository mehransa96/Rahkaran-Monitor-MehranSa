<?xml version="1.0" encoding="UTF-8"?>
<!-- Lab fixture (IIS 10 shape). Values are invented test data; names follow spec §10.1 role patterns. -->
<configuration>
  <system.applicationHost>
    <applicationPools>
      <add name="DefaultAppPool" />
      <add name="AuxPool1" managedRuntimeVersion="" startMode="AlwaysRunning">
        <processModel idleTimeout="00:00:00" />
        <recycling>
          <periodicRestart time="00:00:00">
            <schedule>
              <add value="03:00:00" />
            </schedule>
          </periodicRestart>
        </recycling>
        <cpu numaNodeAssignment="WindowsScheduling" numaNodeAffinityMode="Hard" smpAffinitized="true" smpProcessorAffinityMask="4294967295" />
      </add>
      <add name="AuxPool2" managedRuntimeVersion="" startMode="AlwaysRunning">
        <processModel idleTimeout="00:00:00" identityType="SpecificUser" userName="CORP\svc_rk" password="[enc:IISCngProvider:AAAAsecretBlob==:enc]" />
        <recycling>
          <periodicRestart time="00:00:00" />
        </recycling>
        <cpu numaNodeAssignment="WindowsScheduling" numaNodeAffinityMode="Hard" />
      </add>
      <add name="RouterPool" managedRuntimeVersion="v4.0" enable32BitAppOnWin64="true" queueLength="5000">
        <processModel maxProcesses="2" />
      </add>
      <applicationPoolDefaults managedRuntimeVersion="v4.0">
        <processModel identityType="ApplicationPoolIdentity" />
      </applicationPoolDefaults>
    </applicationPools>
    <sites>
      <site name="Default Web Site" id="1" serverAutoStart="false">
        <application path="/">
          <virtualDirectory path="/" physicalPath="%SystemDrive%\inetpub\wwwroot" />
        </application>
        <bindings>
          <binding protocol="http" bindingInformation="*:80:" />
        </bindings>
      </site>
      <site name="AuxWebsite1" id="2">
        <application path="/" applicationPool="AuxPool1">
          <virtualDirectory path="/" physicalPath="D:\Rahkaran\Aux1" />
        </application>
        <bindings>
          <binding protocol="http" bindingInformation="*:8081:" />
        </bindings>
        <logFile directory="D:\IISLogs" logExtFileFlags="Date, Time, ClientIP, Method, UriStem, HttpStatus, HttpSubStatus, Win32Status, TimeTaken" />
      </site>
      <site name="AuxWebsite2" id="3">
        <application path="/" applicationPool="AuxPool2">
          <virtualDirectory path="/" physicalPath="D:\Rahkaran\Aux2" />
        </application>
        <bindings>
          <binding protocol="http" bindingInformation="*:8082:" />
        </bindings>
        <logFile logExtFileFlags="Date, Time, ClientIP, Method, UriStem, HttpStatus" />
      </site>
      <site name="AppRouterWebsite" id="4">
        <application path="/" applicationPool="RouterPool">
          <virtualDirectory path="/" physicalPath="D:\Rahkaran\Router" />
        </application>
        <application path="/Rahkaran73" applicationPool="RouterPool">
          <virtualDirectory path="/" physicalPath="D:\Rahkaran\Router\Rahkaran73" />
        </application>
        <bindings>
          <binding protocol="https" bindingInformation="10.0.0.5:443:rk.example.local" certificateHash="AB12CD34" certificateStoreName="My" />
          <binding protocol="net.tcp" bindingInformation="808:*" />
        </bindings>
      </site>
      <siteDefaults>
        <logFile logFormat="W3C" directory="%SystemDrive%\inetpub\logs\LogFiles" />
      </siteDefaults>
      <applicationDefaults applicationPool="DefaultAppPool" />
    </sites>
  </system.applicationHost>
  <system.webServer>
    <proxy enabled="true" />
    <rewrite>
      <globalRules>
        <rule name="ARR_RahkaranFarm_loadbalance" enabled="true" patternSyntax="Wildcard" stopProcessing="true">
          <match url="*" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="rk.example.local" />
          </conditions>
          <action type="Rewrite" url="http://RahkaranFarm/{R:0}" />
        </rule>
        <rule name="Route old app path" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://RahkaranFarm/Rahkaran72/api/{R:1}" />
        </rule>
      </globalRules>
    </rewrite>
  </system.webServer>
  <webFarms>
    <webFarm name="RahkaranFarm" enabled="true">
      <server address="app01" enabled="true">
        <applicationRequestRouting weight="100" httpPort="8081" />
      </server>
      <server address="app02" enabled="true">
        <applicationRequestRouting weight="100" httpPort="8081" />
      </server>
      <server address="app03" enabled="false">
        <applicationRequestRouting weight="50" />
      </server>
      <applicationRequestRouting>
        <loadBalancing algorithm="WeightedRoundRobin" />
        <healthCheck url="http://rk.example.local/health" interval="00:00:30" />
      </applicationRequestRouting>
    </webFarm>
    <webFarm name="EmptyFarm" enabled="true" />
  </webFarms>
  <location path="AuxWebsite1">
    <system.webServer>
      <rewrite>
        <rules>
          <rule name="site rule">
            <match url="old/(.*)" />
            <action type="Redirect" url="/new/{R:1}" />
          </rule>
        </rules>
      </rewrite>
    </system.webServer>
  </location>
</configuration>
