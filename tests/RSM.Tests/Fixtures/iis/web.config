<?xml version="1.0" encoding="utf-8"?>
<!-- Lab fixture: every secret pattern of spec §10.8 must be masked. All values are invented test data. -->
<configuration>
  <connectionStrings>
    <add name="Rahkaran" connectionString="Server=sql01\RK;Database=RK_Tehran1405;User ID=rk_app;Password=Pa55-SQL-Secret!;TrustServerCertificate=True" />
    <add name="Reports" connectionString="Data Source=sql02;Initial Catalog=ReportServer;Integrated Security=SSPI" />
    <add name="RedisCache" connectionString="redis01:6379,password=Redis-Secret-42,ssl=false" />
  </connectionStrings>
  <appSettings>
    <add key="RedisServer" value="redis01:6379" />
    <add key="Jwt.SigningKey" value="jwt-key-material-123" />
    <add key="ApiToken" value="tok_ABCDEF987" />
    <add key="ClientSecret" value="client-secret-xyz" />
    <add key="MailPwd" value="mail-pwd-555" />
    <add key="CallbackUrl" value="https://svc:url-pass-777@callback.example.local/hook" />
    <add key="Legacy" value="server=sql03;uid=legacy;pwd=Legacy-Pwd-1;database=Old" />
    <add key="Culture" value="fa-IR" />
  </appSettings>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <aspNetCore processPath="dotnet" arguments=".\Rahkaran.Host.dll --token Arg-Token-999 --mode server" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ConnectionStrings__Default" value="Server=sql01;Database=RK;Password=Env-CS-Secret" />
          <environmentVariable name="Jwt__Secret" value="env-jwt-secret" />
          <environmentVariable name="REDIS_HOST" value="redis01:6379" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
      <rewrite>
        <rules>
          <rule name="to app" stopProcessing="true">
            <match url="(.*)" />
            <action type="Rewrite" url="/Rahkaran73/{R:1}" />
          </rule>
        </rules>
      </rewrite>
    </system.webServer>
  </location>
  <system.web>
    <httpRuntime maxRequestLength="51200" executionTimeout="00:05:00" />
    <machineKey validationKey="MACHINE-KEY-VALIDATION" decryptionKey="MACHINE-KEY-DECRYPT" />
  </system.web>
</configuration>
